# Filter the repository-root build context used by both Python and frontend images.

# Host Git metadata.
.git

# Installed dependencies and generated frontend assets.
.venv
node_modules
frontend/node_modules
frontend/dist

# Build outputs, runtime state, local worktrees, and Python caches.
build/
.run
.worktrees
**/__pycache__
*.pyc
*.egg-info

# The bundled registry cannot commit updates: its submodule pointer refers to excluded
# host Git metadata. Compose mounts the writable clone prepared by make dev instead.
