# Serve the browser app and proxy Mendel and Wiener under the same origin.
# A template: the nginx image fills ${WIENER_PROXY_AUTHORIZATION} from the environment at start.
# This file is copied into the browser image by frontend/Dockerfile.

# Forward an upgrade connection only for clients requesting one, including run WebSockets.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

# **The token Wiener asks for, so a person need not** (issue 498). The worker behind Wiener holds
# the host's Docker socket, and WIENER_API_TOKEN is the boundary in front of it. A browser that
# sends its own Authorization header keeps it; otherwise the proxy adds the one Compose gives it.
# Development sets that from .env, where this port is bound to loopback; production sets it
# empty, because its port is public and anyone reaching it would reach the host.
map $http_authorization $wiener_authorization {
  default $http_authorization;
  "" "${WIENER_PROXY_AUTHORIZATION}";
}

server {
  listen 80;

  # Resolve variable upstreams through Docker DNS so API container replacements can acquire
  # new addresses without rebuilding the proxy. Cache DNS answers for 10 seconds.
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Wiener owns run, artifact and execution-settings routes. Mendel owns the remaining API.
  # Keep this split aligned with the development proxy in frontend/vite.config.ts.
  # Run streams require HTTP/1.1 and explicit WebSocket upgrade headers.
  # Run → Console's terminals (#511): a regex location, so it wins over /api/runs below.
  location ~ ^/api/runs/[^/]+/terminal/ {
    set $term http://wiener-term:8002;
    proxy_pass $term$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Authorization $wiener_authorization;
    proxy_set_header Host $host;
    proxy_read_timeout 1d;
  }

  location /api/runs {
    set $wiener http://wiener-api:8001;
    proxy_pass $wiener$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Authorization $wiener_authorization;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Allow a day between upstream reads on a long-lived run stream.
    proxy_read_timeout 1d;
  }

  location /api/artifacts {
    set $wiener http://wiener-api:8001;
    proxy_pass $wiener$request_uri;
    proxy_set_header Authorization $wiener_authorization;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Artifact uploads carry a complete pipeline bundle.
    client_max_body_size 512m;
  }

  # Execution settings and status are served by Wiener.
  location /api/wiener {
    set $wiener http://wiener-api:8001;
    proxy_pass $wiener$request_uri;
    proxy_set_header Authorization $wiener_authorization;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /api/ {
    set $upstream http://api:8000;
    proxy_pass $upstream$request_uri;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Fall back to index.html for browser routes so deep links survive a page refresh.
  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /index.html;
  }
}
