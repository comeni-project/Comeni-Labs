# worktrees — isolated implementation workspaces, never committed
.worktrees/

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
/build/

# The forge's workspaces. Anchored, like /build/ above and for the same reason: an
# unanchored `.forge` would also match a vendored module directory called that, which is
# exactly how vendor/modules/nf-core/hisat2/build/ went missing.
/.forge/
/.forge-demo/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# nextflow
.nextflow/
.nextflow.log*
work/
results/

# node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# local
.env
.env.local
.DS_Store

# local IDE files
.vscode
# Harness-created agent worktrees. `.worktrees/` (the project convention) is already
# ignored above; this is the path `EnterWorktree` and background agents use, and a
# `git add -A` will otherwise commit them as embedded-repo gitlinks.
.claude/worktrees/

# mendel-api local state
/workspace/
.run/

# The seeded design canvases — megabytes of editor payload each, regenerated by the design
# skill's seed-canvas.mjs from the .dc.html sources and canvas.json beside them, and published
# as Artifacts whose URLs each canvas's README records. The sources are the artifact; the seed
# is a build output.
#
# NAMED ONE BY ONE rather than globbed, for the reason the rule above already gives: `*.html`
# under `.design/` would also swallow the `.dc.html` artboards and the `_*.html` partials the
# generators compose them from — the same shape of mistake as the unanchored `build/` that
# swallowed a vendored module. A new canvas adds a line here.
/.design/comeni-visual-directions.html
/.design/w2-mockups/wiener-w2-screens.html
/.design/runs-board/runs-board.html
