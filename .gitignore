# Keep local environments, runtime data, and generated outputs out of commits.
# Root-only output paths are anchored so similarly named source directories stay visible.

# Isolated agent worktrees.
.worktrees/

# Python environments, build outputs, and test/lint caches.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
/build/
/profile-build/

# Forge demonstration and tool-adaptation workspaces.
/.forge/
/.forge-demo/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Nextflow execution state and results.
.nextflow/
.nextflow.log*
work/
results/

# Frontend dependencies and generated assets.
node_modules/
frontend/dist/
*.tsbuildinfo

# Local configuration and operating-system files.
.env*
!.env.example
!.env.*.example
.DS_Store

# Editor settings and agent-created worktrees.
.vscode
# Prevent nested agent repositories from being added as gitlinks.
.claude/worktrees/

# Mendel's local workspace and Compose runtime state.
/workspace/
.run/
/var/wiener/

# Generated design previews. Keep .dc.html artboards, partials, and canvas metadata.
# Add each preview explicitly; a broad HTML pattern would also hide authored sources.
/.design/comeni-visual-directions.html
/.design/w2-mockups/wiener-w2-screens.html
/.design/runs-board/runs-board.html
/.design/forge-registry-boards.html
/.design/living-pipeline/living-pipeline.html

# JetBrains checkout settings.
.idea/

# Generated documentation site.
/site/

# Generated catalogue and tool pages, including nested organisation directories.
# The authored introduction is docs/reference/tools.md, outside the generated tree.
/docs/reference/tools/*.md
/docs/reference/tools/**/*.md
