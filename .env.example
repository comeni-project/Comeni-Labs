# Every setting `mendel-api` reads, with its default. Copy to `.env` — `make dev` does that for
# you on first run — and change what you need. `.env` is git-ignored; this file is committed and
# is the only place these are written down outside the class that declares them.

# **Where the registry lives, and the one to read twice.**
#
# Point this at a git checkout you can WRITE to. Accepting a drift is a commit, so:
#   - a directory that is not a checkout refuses with MF0107
#   - a checkout at a detached HEAD refuses with MF0105
#
# `registry/` in this repository is a git submodule pinned to a commit, so it is BOTH of those
# from inside a container: a submodule's `.git` is a pointer at a host path that resolves to
# nothing there. `make dev` clones it to `.run/registry` and mounts that, which is why drift
# acceptance works in dev exactly as it does in prod.
MENDEL_REGISTRY_ROOT=./registry

# There is no MENDEL_SOURCE_ROOT. It named a second root holding the module code the
# registry's contracts describe — a different repository on a different release cadence — and
# Plan 5A moved that code into the layer. `MENDEL_REGISTRY_ROOT` is the whole input now.

# Where drafts live. Outside every registry layer on purpose: a draft is work in progress and
# a layer is a unit that gets distributed.
MENDEL_WORKSPACE_ROOT=./workspace

# Postgres. Two small tables — when a source check last ran, and when a curator last looked.
# The registry is files by decision (issue #43); none of it is in here.
MENDEL_DATABASE_URL=postgresql+psycopg://mendel:mendel@localhost:5432/mendel

# Redis, for the ARQ worker that runs the nightly source check.
MENDEL_REDIS_URL=redis://localhost:6379

# ── container names, so two checkouts can run side by side ────────────────────────────────
# API_CONTAINER_NAME=mendel-api
# WORKER_CONTAINER_NAME=mendel-worker
# WEB_CONTAINER_NAME=mendel-web
# API_HOST_PORT=8000
# WEB_HOST_PORT=80

# Wiener's public API. **Unset means open**, which is right for a laptop and wrong for anything
# reachable — docs/design/wiener.md §12.1. Generate one with: openssl rand -hex 24
WIENER_API_TOKEN=

# ── model access, shared by every agent in the stack ──────────────────────────────────────
#
# **Unset means no model, and that is the default on purpose.** Nothing here reaches a
# provider until COMENI_AI_MODEL names one — a laboratory that wants no model calls does not
# configure this, which is stronger than a check somebody can forget to run. There is nothing
# to reach a provider *with*.
#
# **One prefix for every consumer.** `comeni-ai` is the shared transport, so the Forge, the
# builder and Wiener's agents read these same names. It was `MENDEL_*` while the package was
# `mendel-ai`; those spellings are still read as a fallback, and setting both makes the
# COMENI_AI_ one win. Do not add an engine-specific prefix here.
#
# Invariant 13 — self-hosted is not a degraded tier. The two lanes below differ by these
# values and by nothing else:
#
#   local     COMENI_AI_MODEL=ollama/llama3.1  COMENI_AI_BASE_URL=http://ollama:11434
#   hosted    COMENI_AI_MODEL=anthropic/claude-sonnet-4-5  COMENI_AI_API_KEY=sk-...
#
# LiteLLM wants `<provider>/<model>`; a bare model id refuses with MA0007.
COMENI_AI_MODEL=
COMENI_AI_API_KEY=
COMENI_AI_BASE_URL=
# COMENI_AI_TIMEOUT_SECONDS=60
# **Zero, and the default is the point.** A provider's own default is non-zero, so two runs of
# the same question could differ and a measurement comparing two prompts would be partly
# measuring the dice.
# COMENI_AI_TEMPERATURE=0.0
# How many model jobs run at once. One, so a long generation cannot be started twenty times by
# twenty clicks, and so a gate never waits behind one. Read by the AI worker.
# COMENI_AI_MAX_CONCURRENT_JOBS=1

# Invariant 12 — no subscription OAuth. A Claude Pro/Max token in a third-party tool violates
# Anthropic's Consumer ToS. There is no field to put one in and `ModelAccess` forbids extras.
