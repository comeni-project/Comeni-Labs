# Every setting `mendel-api` reads, with its default. Copy to `.env` — `make dev` does that for
# you on first run — and change what you need. `.env` is git-ignored; this file is committed and
# is the only place these are written down outside the class that declares them.

# **Where the registry lives, and the one to read twice.**
#
# Point this at a git checkout you can WRITE to. Accepting a drift is a commit, so:
#   - a directory that is not a checkout refuses with MF0107
#   - a checkout at a detached HEAD refuses with MF0105
#
# `registry/` in this repository is a git submodule pinned to a commit, so it is BOTH of those
# from inside a container: a submodule's `.git` is a pointer at a host path that resolves to
# nothing there. `make dev` clones it to `.run/registry` and mounts that, which is why drift
# acceptance works in dev exactly as it does in prod.
MENDEL_REGISTRY_ROOT=./registry

# The vendored tool sources — nf-core modules and their `meta.yml`. Read on nearly every
# request, and the thing `forge check` compares the registry against. Offline by decision;
# whether UPSTREAM has moved is issue #64.
MENDEL_SOURCE_ROOT=./vendor

# Where drafts live. Outside every registry layer on purpose: a draft is work in progress and
# a layer is a unit that gets distributed.
MENDEL_WORKSPACE_ROOT=./workspace

# Postgres. Two small tables — when a source check last ran, and when a curator last looked.
# The registry is files by decision (issue #43); none of it is in here.
MENDEL_DATABASE_URL=postgresql+psycopg://mendel:mendel@localhost:5432/mendel

# Redis, for the ARQ worker that runs the nightly source check.
MENDEL_REDIS_URL=redis://localhost:6379

# ── container names, so two checkouts can run side by side ────────────────────────────────
# API_CONTAINER_NAME=mendel-api
# WORKER_CONTAINER_NAME=mendel-worker
# WEB_CONTAINER_NAME=mendel-web
# API_HOST_PORT=8000
# WEB_HOST_PORT=80
