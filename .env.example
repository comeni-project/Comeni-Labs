# Local configuration examples. Copy to .env and edit; make dev creates it if absent.
# Sections: host paths and storage; Compose overrides; API access; model access;
#           stored credentials; local model server; upstream catalogues.
# .env is Git-ignored. Keep real credentials there, not in this committed example.
# Host Python commands need these values exported; Compose reads .env for interpolation
# and passes the variables declared in docker-compose.yml to each service.

# -----------------------------------------------------------------------------
# 1. Host paths and storage
# -----------------------------------------------------------------------------
# Registry declarations and module source. Accepting updates requires a writable Git
# checkout on a branch: a non-checkout refuses with MF0107, detached HEAD with MF0105.
# The registry/ submodule is suitable for reading. In containers its .git pointer cannot
# resolve host metadata, so make dev mounts a separate clone from .run/registry.
MENDEL_REGISTRY_ROOT=./registry

# Tool-adaptation drafts stay outside registry layers until approved for landing.
MENDEL_WORKSPACE_ROOT=./workspace

# Mendel application records, including authoring sessions and settings.
# Registry declarations remain files. Compose supplies its own internal database URL.
MENDEL_DATABASE_URL=postgresql+psycopg://mendel:mendel@localhost:5432/mendel

# Mendel's background-job queues. Compose uses the internal redis service address.
MENDEL_REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# 2. Compose overrides
# -----------------------------------------------------------------------------
# Optional names and published ports; defaults are shown below.
# These are a subset: see docker-compose.yml for database, Redis, Wiener and telemetry
# overrides. Two checkouts need distinct container names AND published ports; host Vite
# ports also need coordination. Changing only COMPOSE_PROJECT_NAME does not rename
# containers with explicit container_name values.
# API_CONTAINER_NAME=mendel-api
# WORKER_CONTAINER_NAME=mendel-worker
# AI_WORKER_CONTAINER_NAME=mendel-ai-worker
# OLLAMA_CONTAINER_NAME=mendel-ollama
# WEB_CONTAINER_NAME=mendel-web
# WIKI_CONTAINER_NAME=mendel-wiki
# API_HOST_PORT=8000
# WEB_HOST_PORT=80
# OLLAMA_HOST_PORT=11434
# The wiki uses 8010 to avoid the API's default port; make dev also uses it for its link.
# WIKI_HOST_PORT=8010

# -----------------------------------------------------------------------------
# 3. API access
# -----------------------------------------------------------------------------
# Bearer token for Wiener's run-management API. Empty disables authentication.
# Set it before exposing the app beyond localhost: the worker can execute pipelines
# through the host Docker socket. Generate a token with: openssl rand -hex 24
WIENER_API_TOKEN=

# -----------------------------------------------------------------------------
# 4. Model access
# -----------------------------------------------------------------------------
# Shared provider configuration. With no environment model or model selected through
# Settings, model calls are unavailable. An empty COMENI_AI_MODEL alone does not disable
# models saved in Settings or configured through purpose-specific environment overrides.
# The nonempty COMENI_AI_* value takes precedence over its deprecated MENDEL_* alias.
# Use API keys or local endpoints; subscription OAuth tokens are unsupported.
#
# Examples (provider/model syntax; a bare model ID refuses with MA0007):
#   local:  COMENI_AI_MODEL=ollama_chat/gemma3:12b
#           COMENI_AI_BASE_URL=http://ollama:11434
#   hosted: COMENI_AI_MODEL=anthropic/claude-sonnet-4-5
#           COMENI_AI_API_KEY=<provider-key>
# Use ollama_chat/ for chat responses. make ai-up starts the local server.
# ollama is the Compose hostname; localhost inside a worker refers to that worker.
# Host commands need the model server's published host address instead.
COMENI_AI_MODEL=
COMENI_AI_API_KEY=
COMENI_AI_BASE_URL=
# Timeout for one provider request, separate from the worker's whole-job timeout.
# COMENI_AI_TIMEOUT_SECONDS=60

# Reduce sampling randomness; zero does not guarantee identical model responses.
# COMENI_AI_TEMPERATURE=0.0

# Maximum simultaneous model jobs in Mendel's separate AI queue.
# COMENI_AI_MAX_CONCURRENT_JOBS=1

# -----------------------------------------------------------------------------
# 5. Credentials saved through Settings
# -----------------------------------------------------------------------------
# Fernet encryption key for secrets entered in the Settings menu. Without it, use
# environment credentials instead; the menu cannot save a secret. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the key stable: replacing it makes existing stored credentials unreadable.
COMENI_SETTINGS_KEY=

# -----------------------------------------------------------------------------
# 6. Local model server
# -----------------------------------------------------------------------------
# Reuse a host Ollama model directory instead of the default named volume.
# OLLAMA_MODELS=/home/you/.ollama

# Override the image when a different GPU runtime is needed.
# AMD requires a ROCm image AND the device overlay: make ai-up OLLAMA_GPU=rocm.
# NVIDIA uses the standard image with the host NVIDIA container toolkit configured.
# OLLAMA_IMAGE=ollama/ollama:0.6.5-rocm

# AMD device-group IDs; find the host values with: getent group render video
# RENDER_GID=988
# VIDEO_GID=984

# -----------------------------------------------------------------------------
# 7. Forge upstream catalogues
# -----------------------------------------------------------------------------
# GitHub credentials raise the rate limit for public catalogue reads. No write access
# is needed. Anonymous requests work for small lookups, but a full sync may hit the limit.
# Create credentials at https://github.com/settings/tokens .
COMENI_FORGE_GITHUB_TOKEN=

# Docker Hub username and read-only access token, exchanged for a login session.
# Both are required for authenticated catalogue pagination; anonymous pagination can
# stop before all pegi3s entries are read, which the adapter reports as incomplete.
# nf-core does not require Docker Hub credentials.
# Create a token at https://app.docker.com/settings/personal-access-tokens .
COMENI_FORGE_DOCKERHUB_USER=
COMENI_FORGE_DOCKERHUB_TOKEN=
