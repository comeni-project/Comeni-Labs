{
  "$defs": {
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "params": {
          "items": {
            "$ref": "#/$defs/ParamOverride"
          },
          "type": "array"
        },
        "producers": {
          "items": {
            "$ref": "#/$defs/ProducerPin"
          },
          "type": "array"
        },
        "required_states": {
          "items": {
            "$ref": "#/$defs/RequiredStates"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "stated": {
          "items": {
            "$ref": "#/$defs/StatedCandidate"
          },
          "type": "array"
        },
        "suggested": {
          "$ref": "#/$defs/Constraints"
        },
        "want": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "want"
      ],
      "type": "object"
    },
    "ParamOverride": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "ProducerPin": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "type": "string"
        },
        "site": {
          "$ref": "#/$defs/Site"
        }
      },
      "required": [
        "site",
        "contract"
      ],
      "type": "object"
    },
    "RequiredStates": {
      "additionalProperties": false,
      "properties": {
        "states": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type_id": {
          "type": "string"
        }
      },
      "required": [
        "type_id"
      ],
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "properties": {
        "states": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "type_id": {
          "type": "string"
        }
      },
      "required": [
        "type_id"
      ],
      "type": "object"
    },
    "StatedCandidate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "input",
            "measurement"
          ],
          "type": "string"
        },
        "subject": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "subject"
      ],
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Extraction"
    },
    {
      "type": "null"
    }
  ]
}
