{"openapi": "3.1.0", "info": {"title": "wiener-api", "version": "0.1.0"}, "paths": {"/api/artifacts": {"post": {"summary": "Upload a gated pipeline directory", "operationId": "uploadArtifact", "requestBody": {"content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/Body_uploadArtifact"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactStored"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs": {"post": {"summary": "Run a pipeline", "operationId": "submitRun", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitRequest"}}}}, "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunAccepted"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "get": {"summary": "The board", "description": "One page of runs, newest first, with each row's task tally beside it.", "operationId": "listRuns", "parameters": [{"name": "phase", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Phase"}}, {"name": "who", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Who"}}, {"name": "executor", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Executor"}}, {"name": "after", "in": "query", "required": false, "schema": {"type": "integer", "default": 0, "title": "After"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 25, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunsPage"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/summary": {"get": {"summary": "What the board's tiles count", "description": "**Declared before `/runs/{run_id}`**, or FastAPI matches `summary` as a run id and every\nrequest 404s on a run nobody asked for. A literal path and a parameterised one that can\nboth match are ordered, never disambiguated.", "operationId": "readBoardSummary", "parameters": [{"name": "days", "in": "query", "required": false, "schema": {"type": "integer", "default": 14, "title": "Days"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BoardSummary"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}": {"get": {"summary": "A run, projected", "operationId": "readRun", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Readrun"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/events": {"get": {"summary": "The record, in order", "description": "What the console reads before it subscribes \u2014 \u00a77.2's page-then-tail handoff.", "operationId": "readRunEvents", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}, {"name": "after", "in": "query", "required": false, "schema": {"type": "integer", "default": -1, "title": "After"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 200, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventPage"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/graph": {"get": {"summary": "The pipeline's own graph, coloured by what the run did", "description": "**Nothing new is computed** \u2014 \u00a79.1. The layout is `dag-core`'s, the same one the builder\ndraws, and the colouring is the fold's. A graph that cannot disagree with either.", "operationId": "readRunGraph", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunGraphOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/overview": {"get": {"summary": "One row per process the artifact declares", "description": "**It does not 404 on an unreadable artifact** \u2014 A192, and deliberately unlike `/graph`.\nThe counts come from the fold and are true whatever happened to the directory; what is lost\nis the declared list, so every row says `declared: false` and the bar has no denominator.", "operationId": "readOverview", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OverviewOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/tasks": {"get": {"summary": "A run's tasks, filtered, sorted and paged", "description": "**A query, never a fold** \u2014 A191. `sort` is a closed vocabulary and an unknown value\nfalls back to `task_id` rather than reaching the database.\n\n**`tag` is scoped to this run and there is no endpoint that lists tags.** Answering *how\ndid sampleB do* needs only the filter; answering *which samples exist* would be a distinct\nquery over lab strings, which is the deployment-wide search A200 refused. The table already\nshows every tag on the page, so a person picks one from what is in front of them.", "operationId": "readTasks", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}, {"name": "process", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Process"}}, {"name": "status", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Status"}}, {"name": "retried_only", "in": "query", "required": false, "schema": {"type": "boolean", "default": false, "title": "Retried Only"}}, {"name": "attempt", "in": "query", "required": false, "schema": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Attempt"}}, {"name": "tag", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Tag"}}, {"name": "sort", "in": "query", "required": false, "schema": {"type": "string", "default": "task_id", "title": "Sort"}}, {"name": "after", "in": "query", "required": false, "schema": {"type": "integer", "default": 0, "title": "After"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 100, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TasksOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/series": {"get": {"summary": "What this run held over time, and which curves are honest", "description": "**A query, never a fold** \u2014 `rn-blocked`, and A191's rule that a board is a query.\n\n`projection.state_of` replays every event a run ever produced; `run_task.attempts` is a\ncolumn holding the same attempts, written by the projection when the row was written. A\n5,000-task run is 15,000 events to fold and one indexed `SELECT` to read.\n\nEvery decision about *which* curves are honest belongs to `wiener_core.series`, which is\npure and reads no clock. This route reads rows and hands them over.", "operationId": "readSeries", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Series"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/results": {"get": {"summary": "What a run published", "description": "A directory walk, and deliberately nothing more.\n\n**Nothing here resolves anything** \u2014 the 2026-08-19 audit found every registry-touching\nscreen cost ~250ms warm, and a results list has no reason to be one of them.\n\n**Paged, because a 5,000-task run publishes more than a page.** W2 shipped a console that\nfetched once at 200 and subscribed, and it was invisible on every run anybody had because\nthe largest was five tasks. Same mistake, same file, one endpoint along.\n\n`lab_id` is enforced the way `repository.py`'s header asks: this hands back filenames, and a\nfilter you can forget is a leak.", "operationId": "readResults", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}, {"name": "after", "in": "query", "required": false, "schema": {"type": "integer", "default": 0, "title": "After"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 200, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResultsOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/health": {"get": {"summary": "Is Wiener up", "operationId": "health", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Health"}}}}}}}}, "components": {"schemas": {"ArtifactStored": {"properties": {"artifact_id": {"type": "string", "title": "Artifact Id"}, "digest": {"type": "string", "title": "Digest"}, "size_bytes": {"type": "integer", "title": "Size Bytes"}, "declared": {"items": {"type": "string"}, "type": "array", "title": "Declared", "default": []}, "input_form": {"type": "string", "enum": ["direct", "samplesheet"], "title": "Input Form", "default": "direct"}, "input_columns": {"items": {"type": "string"}, "type": "array", "title": "Input Columns", "default": []}}, "type": "object", "required": ["artifact_id", "digest", "size_bytes"], "title": "ArtifactStored"}, "AttemptOut": {"properties": {"n": {"type": "integer", "title": "N"}, "status": {"type": "string", "title": "Status"}, "exit": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Exit"}, "signal": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Signal"}, "memory_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Memory Bytes"}, "peak_rss_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Peak Rss Bytes"}, "realtime_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Realtime Ms"}}, "type": "object", "required": ["n", "status"], "title": "AttemptOut", "description": "One try, with what it ASKED FOR beside what it TOUCHED.\n\n**Both halves, or neither is worth showing.** `peak_rss_bytes` alone says a task touched\n47 GB and leaves *was that a lot?* to the reader; `memory_bytes` is the reservation it was\ngiven, and the pair is what makes 36 \u2192 48 \u2192 72 a story rather than three numbers.\n\nEvery field is nullable, because a run launched without `trace.enabled` recorded none of\nthem \u2014 **absent rather than zero** (\u00a74.3 finding 6)."}, "BoardSummary": {"properties": {"window_days": {"type": "integer", "title": "Window Days"}, "failed": {"type": "integer", "title": "Failed"}, "running": {"type": "integer", "title": "Running"}, "succeeded": {"type": "integer", "title": "Succeeded"}, "total": {"type": "integer", "title": "Total"}, "median_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Median Ms"}, "p95_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "P95 Ms"}, "days": {"items": {"$ref": "#/components/schemas/DayCount"}, "type": "array", "title": "Days"}, "by_pipeline": {"additionalProperties": {"type": "integer"}, "type": "object", "title": "By Pipeline", "default": {}}}, "type": "object", "required": ["window_days", "failed", "running", "succeeded", "total", "median_ms", "p95_ms", "days"], "title": "BoardSummary", "description": "What the tiles count. **Every field is a tally or a percentile over `run`** \u2014 nothing\nhere folds an event stream, which is what keeps the board a page and not a job."}, "Body_uploadArtifact": {"properties": {"bundle": {"type": "string", "contentMediaType": "application/octet-stream", "title": "Bundle"}}, "type": "object", "required": ["bundle"], "title": "Body_uploadArtifact"}, "Curve": {"properties": {"name": {"type": "string", "title": "Name"}, "kind": {"$ref": "#/components/schemas/Kind"}, "unit": {"type": "string", "title": "Unit"}, "points": {"items": {"$ref": "#/components/schemas/Point"}, "type": "array", "title": "Points", "default": []}}, "additionalProperties": false, "type": "object", "required": ["name", "kind", "unit"], "title": "Curve"}, "DayCount": {"properties": {"day": {"type": "string", "title": "Day"}, "succeeded": {"type": "integer", "title": "Succeeded"}, "failed": {"type": "integer", "title": "Failed"}}, "type": "object", "required": ["day", "succeeded", "failed"], "title": "DayCount"}, "DrawnWire": {"properties": {"from_node": {"type": "string", "title": "From Node"}, "from_port": {"type": "string", "title": "From Port"}, "to_node": {"type": "string", "title": "To Node"}, "to_port": {"type": "string", "title": "To Port"}, "points": {"items": {"additionalProperties": {"type": "integer"}, "type": "object"}, "type": "array", "title": "Points"}, "active": {"type": "boolean", "title": "Active", "default": false}, "bytes_moved": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Bytes Moved"}}, "type": "object", "required": ["from_node", "from_port", "to_node", "to_port", "points"], "title": "DrawnWire"}, "EventPage": {"properties": {"events": {"items": {"additionalProperties": true, "type": "object"}, "type": "array", "title": "Events"}, "cursor": {"type": "integer", "title": "Cursor"}, "stream_id": {"type": "string", "title": "Stream Id"}}, "type": "object", "required": ["events", "cursor", "stream_id"], "title": "EventPage", "description": "A page of the record, **and where to subscribe from when you have read it**.\n\nThe handoff is the only ordering subtlety in the console (\u00a77.2), so it is a field rather\nthan a convention: page from Postgres, then tail from `stream_id`. A browser that has been\nclosed for a day does not scroll back through Redis."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "Kind": {"type": "string", "enum": ["exact", "derived"], "title": "Kind", "description": "How much a curve's shape can be trusted.\n\n**Two members, and the absence of a third is the design.** A peak has no honest shape, so\nthere is nowhere in this type to record one \u2014 which is a stronger guarantee than a comment\nasking nobody to try."}, "OverviewOut": {"properties": {"rows": {"items": {"$ref": "#/components/schemas/ProcessRowOut"}, "type": "array", "title": "Rows", "default": []}, "steps_declared": {"type": "integer", "title": "Steps Declared", "default": 0}, "steps_finished": {"type": "integer", "title": "Steps Finished", "default": 0}}, "type": "object", "title": "OverviewOut"}, "PlacedNode": {"properties": {"id": {"type": "string", "title": "Id"}, "process": {"type": "string", "title": "Process"}, "x": {"type": "integer", "title": "X"}, "y": {"type": "integer", "title": "Y"}, "width": {"type": "integer", "title": "Width"}, "height": {"type": "integer", "title": "Height"}, "tier": {"type": "integer", "title": "Tier"}, "inputs": {"items": {"type": "string"}, "type": "array", "title": "Inputs", "default": []}, "outputs": {"items": {"type": "string"}, "type": "array", "title": "Outputs", "default": []}, "done": {"type": "integer", "title": "Done", "default": 0}, "failed": {"type": "integer", "title": "Failed", "default": 0}, "running": {"type": "integer", "title": "Running", "default": 0}, "total": {"type": "integer", "title": "Total", "default": 0}, "attempts": {"type": "integer", "title": "Attempts", "default": 1}}, "type": "object", "required": ["id", "process", "x", "y", "width", "height", "tier"], "title": "PlacedNode", "description": "A node, where the layout put it, and what the run did to it."}, "Point": {"properties": {"at_ms": {"type": "integer", "title": "At Ms"}, "value": {"type": "number", "title": "Value"}}, "additionalProperties": false, "type": "object", "required": ["at_ms", "value"], "title": "Point"}, "ProcessRowOut": {"properties": {"process": {"type": "string", "title": "Process"}, "declared": {"type": "boolean", "title": "Declared", "default": false}, "reached": {"type": "boolean", "title": "Reached", "default": false}, "tasks": {"type": "integer", "title": "Tasks", "default": 0}, "done": {"type": "integer", "title": "Done", "default": 0}, "running": {"type": "integer", "title": "Running", "default": 0}, "failed": {"type": "integer", "title": "Failed", "default": 0}, "cached": {"type": "integer", "title": "Cached", "default": 0}, "attempts_max": {"type": "integer", "title": "Attempts Max", "default": 1}, "memory_asked_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Memory Asked Bytes"}, "memory_peak_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Memory Peak Bytes"}, "cpus_asked": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Cpus Asked"}, "cpu_used_pct": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Cpu Used Pct"}, "realtime_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Realtime Ms"}, "queue_wait_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Queue Wait Ms"}, "read_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Read Bytes"}, "write_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Write Bytes"}}, "type": "object", "required": ["process"], "title": "ProcessRowOut", "description": "One process's row. **Absent is not zero** \u2014 a `null` here means the run was launched\nwithout `trace.enabled` and nothing was reported, or the run has not reached this process\nat all. The interface renders both as a dash and neither as a number.\n\nMirrored from `wiener_core.ProcessRow` rather than reused, the way `/graph`'s models are:\nthe wire format is `wiener-api`'s to keep stable, and the pure package's types answer to\nthe fold. Declared field by field rather than as a `dict`, because the generated client is\nwhat stops the two halves drifting and a `dict` reaches TypeScript as nothing at all."}, "ResultFile": {"properties": {"process": {"type": "string", "title": "Process"}, "name": {"type": "string", "title": "Name"}, "size_bytes": {"type": "integer", "title": "Size Bytes"}, "modified_ms": {"type": "integer", "title": "Modified Ms"}}, "type": "object", "required": ["process", "name", "size_bytes", "modified_ms"], "title": "ResultFile", "description": "One published file. Every field is read off the filesystem; nothing is inferred."}, "ResultsOut": {"properties": {"files": {"items": {"$ref": "#/components/schemas/ResultFile"}, "type": "array", "title": "Files", "default": []}, "total": {"type": "integer", "title": "Total", "default": 0}, "published": {"type": "boolean", "title": "Published"}}, "type": "object", "required": ["published"], "title": "ResultsOut", "description": "What a run published, and \u2014 when it published nothing \u2014 which kind of nothing.\n\n**Three absences, and they are different facts.** `rn-absence`'s rule and\n`ProcessRow.reported_resources` are the shape being copied: an empty list for all three\nwould say *this run produced no output* about a run that has not started, about a run whose\npipeline predates publishing entirely, and about a run that genuinely made nothing."}, "RunAccepted": {"properties": {"run_id": {"type": "string", "title": "Run Id"}}, "type": "object", "required": ["run_id"], "title": "RunAccepted"}, "RunGraphOut": {"properties": {"nodes": {"items": {"$ref": "#/components/schemas/PlacedNode"}, "type": "array", "title": "Nodes", "default": []}, "wires": {"items": {"$ref": "#/components/schemas/DrawnWire"}, "type": "array", "title": "Wires", "default": []}, "width": {"type": "integer", "title": "Width", "default": 0}, "height": {"type": "integer", "title": "Height", "default": 0}}, "type": "object", "title": "RunGraphOut"}, "RunRow": {"properties": {"id": {"type": "string", "title": "Id"}, "phase": {"type": "string", "title": "Phase"}, "executor": {"type": "string", "title": "Executor"}, "submitted_by": {"type": "string", "title": "Submitted By"}, "submitted_at": {"type": "string", "format": "date-time", "title": "Submitted At"}, "ended_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Ended At"}, "tasks_done": {"type": "integer", "title": "Tasks Done", "default": 0}, "tasks_seen": {"type": "integer", "title": "Tasks Seen", "default": 0}, "pipeline_digest": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Pipeline Digest"}}, "type": "object", "required": ["id", "phase", "executor", "submitted_by", "submitted_at"], "title": "RunRow"}, "RunsPage": {"properties": {"runs": {"items": {"$ref": "#/components/schemas/RunRow"}, "type": "array", "title": "Runs"}, "total": {"type": "integer", "title": "Total"}}, "type": "object", "required": ["runs", "total"], "title": "RunsPage", "description": "A page of the board, and the total the same filters match."}, "Series": {"properties": {"curves": {"items": {"$ref": "#/components/schemas/Curve"}, "type": "array", "title": "Curves", "default": []}, "from_ms": {"type": "integer", "title": "From Ms", "default": 0}, "to_ms": {"type": "integer", "title": "To Ms", "default": 0}, "open": {"type": "boolean", "title": "Open", "default": false}, "bin_ms": {"type": "integer", "title": "Bin Ms", "default": 0}, "reported_resources": {"type": "boolean", "title": "Reported Resources", "default": false}}, "additionalProperties": false, "type": "object", "title": "Series", "description": "Every curve a run's attempts can honestly support, and the window they cover."}, "SubmitRequest": {"properties": {"artifact_id": {"type": "string", "title": "Artifact Id"}, "params": {"additionalProperties": {"anyOf": [{"type": "string"}, {"items": {"type": "string"}, "type": "array"}, {"items": {"additionalProperties": {"type": "string"}, "type": "object"}, "type": "array"}]}, "type": "object", "title": "Params", "default": {}}, "executor": {"type": "string", "const": "local", "title": "Executor", "default": "local"}}, "additionalProperties": false, "type": "object", "required": ["artifact_id"], "title": "SubmitRequest"}, "TaskOut": {"properties": {"task_id": {"type": "integer", "title": "Task Id"}, "process": {"type": "string", "title": "Process"}, "status": {"type": "string", "title": "Status"}, "attempts": {"type": "integer", "title": "Attempts", "default": 1}, "latest_exit": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Latest Exit"}, "last_change_ms": {"type": "integer", "title": "Last Change Ms", "default": 0}, "peak_rss_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Peak Rss Bytes"}, "realtime_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Realtime Ms"}, "pct_cpu": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Pct Cpu"}, "tag": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Tag"}, "history": {"items": {"$ref": "#/components/schemas/AttemptOut"}, "type": "array", "title": "History", "default": []}}, "type": "object", "required": ["task_id", "process", "status"], "title": "TaskOut", "description": "One task row. `tag` is the laboratory's own word for it \u2014 A200 \u2014 and it is the only\nfield here that a laboratory wrote."}, "TasksOut": {"properties": {"tasks": {"items": {"$ref": "#/components/schemas/TaskOut"}, "type": "array", "title": "Tasks", "default": []}, "total": {"type": "integer", "title": "Total", "default": 0}}, "type": "object", "title": "TasksOut"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
