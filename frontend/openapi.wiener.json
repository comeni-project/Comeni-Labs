{"openapi": "3.1.0", "info": {"title": "wiener-api", "version": "0.1.0"}, "paths": {"/api/artifacts": {"post": {"summary": "Upload a gated pipeline directory", "operationId": "uploadArtifact", "requestBody": {"content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/Body_uploadArtifact"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactStored"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs": {"get": {"summary": "The board", "operationId": "listRuns", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/RunRow"}, "type": "array", "title": "Response Listruns"}}}}}}, "post": {"summary": "Run a pipeline", "operationId": "submitRun", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitRequest"}}}, "required": true}, "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunAccepted"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}": {"get": {"summary": "A run, projected", "operationId": "readRun", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Readrun"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/events": {"get": {"summary": "The record, in order", "description": "What the console reads before it subscribes \u2014 \u00a77.2's page-then-tail handoff.", "operationId": "readRunEvents", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}, {"name": "after", "in": "query", "required": false, "schema": {"type": "integer", "default": -1, "title": "After"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 200, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventPage"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/graph": {"get": {"summary": "The pipeline's own graph, coloured by what the run did", "description": "**Nothing new is computed** \u2014 \u00a79.1. The layout is `dag-core`'s, the same one the builder\ndraws, and the colouring is the fold's. A graph that cannot disagree with either.", "operationId": "readRunGraph", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunGraphOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/overview": {"get": {"summary": "One row per process the artifact declares", "description": "**It does not 404 on an unreadable artifact** \u2014 A192, and deliberately unlike `/graph`.\nThe counts come from the fold and are true whatever happened to the directory; what is lost\nis the declared list, so every row says `declared: false` and the bar has no denominator.", "operationId": "readOverview", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OverviewOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/runs/{run_id}/tasks": {"get": {"summary": "A run's tasks, filtered, sorted and paged", "description": "**A query, never a fold** \u2014 A191. `sort` is a closed vocabulary and an unknown value\nfalls back to `task_id` rather than reaching the database.", "operationId": "readTasks", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Run Id"}}, {"name": "process", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Process"}}, {"name": "status", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Status"}}, {"name": "retried_only", "in": "query", "required": false, "schema": {"type": "boolean", "default": false, "title": "Retried Only"}}, {"name": "sort", "in": "query", "required": false, "schema": {"type": "string", "default": "task_id", "title": "Sort"}}, {"name": "after", "in": "query", "required": false, "schema": {"type": "integer", "default": 0, "title": "After"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 100, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TasksOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/health": {"get": {"summary": "Is Wiener up", "operationId": "health", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Health"}}}}}}}}, "components": {"schemas": {"ArtifactStored": {"properties": {"artifact_id": {"type": "string", "title": "Artifact Id"}, "digest": {"type": "string", "title": "Digest"}, "size_bytes": {"type": "integer", "title": "Size Bytes"}, "declared": {"items": {"type": "string"}, "type": "array", "title": "Declared", "default": []}}, "type": "object", "required": ["artifact_id", "digest", "size_bytes"], "title": "ArtifactStored"}, "Body_uploadArtifact": {"properties": {"bundle": {"type": "string", "contentMediaType": "application/octet-stream", "title": "Bundle"}}, "type": "object", "required": ["bundle"], "title": "Body_uploadArtifact"}, "DrawnWire": {"properties": {"from_node": {"type": "string", "title": "From Node"}, "from_port": {"type": "string", "title": "From Port"}, "to_node": {"type": "string", "title": "To Node"}, "to_port": {"type": "string", "title": "To Port"}, "points": {"items": {"additionalProperties": {"type": "integer"}, "type": "object"}, "type": "array", "title": "Points"}, "active": {"type": "boolean", "title": "Active", "default": false}, "bytes_moved": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Bytes Moved"}}, "type": "object", "required": ["from_node", "from_port", "to_node", "to_port", "points"], "title": "DrawnWire"}, "EventPage": {"properties": {"events": {"items": {"additionalProperties": true, "type": "object"}, "type": "array", "title": "Events"}, "cursor": {"type": "integer", "title": "Cursor"}, "stream_id": {"type": "string", "title": "Stream Id"}}, "type": "object", "required": ["events", "cursor", "stream_id"], "title": "EventPage", "description": "A page of the record, **and where to subscribe from when you have read it**.\n\nThe handoff is the only ordering subtlety in the console (\u00a77.2), so it is a field rather\nthan a convention: page from Postgres, then tail from `stream_id`. A browser that has been\nclosed for a day does not scroll back through Redis."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "OverviewOut": {"properties": {"rows": {"items": {"$ref": "#/components/schemas/ProcessRowOut"}, "type": "array", "title": "Rows", "default": []}, "steps_declared": {"type": "integer", "title": "Steps Declared", "default": 0}, "steps_finished": {"type": "integer", "title": "Steps Finished", "default": 0}}, "type": "object", "title": "OverviewOut"}, "PlacedNode": {"properties": {"id": {"type": "string", "title": "Id"}, "process": {"type": "string", "title": "Process"}, "x": {"type": "integer", "title": "X"}, "y": {"type": "integer", "title": "Y"}, "width": {"type": "integer", "title": "Width"}, "height": {"type": "integer", "title": "Height"}, "tier": {"type": "integer", "title": "Tier"}, "inputs": {"items": {"type": "string"}, "type": "array", "title": "Inputs", "default": []}, "outputs": {"items": {"type": "string"}, "type": "array", "title": "Outputs", "default": []}, "done": {"type": "integer", "title": "Done", "default": 0}, "failed": {"type": "integer", "title": "Failed", "default": 0}, "running": {"type": "integer", "title": "Running", "default": 0}, "total": {"type": "integer", "title": "Total", "default": 0}, "attempts": {"type": "integer", "title": "Attempts", "default": 1}}, "type": "object", "required": ["id", "process", "x", "y", "width", "height", "tier"], "title": "PlacedNode", "description": "A node, where the layout put it, and what the run did to it."}, "ProcessRowOut": {"properties": {"process": {"type": "string", "title": "Process"}, "declared": {"type": "boolean", "title": "Declared", "default": false}, "reached": {"type": "boolean", "title": "Reached", "default": false}, "tasks": {"type": "integer", "title": "Tasks", "default": 0}, "done": {"type": "integer", "title": "Done", "default": 0}, "running": {"type": "integer", "title": "Running", "default": 0}, "failed": {"type": "integer", "title": "Failed", "default": 0}, "cached": {"type": "integer", "title": "Cached", "default": 0}, "attempts_max": {"type": "integer", "title": "Attempts Max", "default": 1}, "memory_asked_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Memory Asked Bytes"}, "memory_peak_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Memory Peak Bytes"}, "cpus_asked": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Cpus Asked"}, "cpu_used_pct": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Cpu Used Pct"}, "realtime_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Realtime Ms"}, "queue_wait_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Queue Wait Ms"}, "read_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Read Bytes"}, "write_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Write Bytes"}}, "type": "object", "required": ["process"], "title": "ProcessRowOut", "description": "One process's row. **Absent is not zero** \u2014 a `null` here means the run was launched\nwithout `trace.enabled` and nothing was reported, or the run has not reached this process\nat all. The interface renders both as a dash and neither as a number.\n\nMirrored from `wiener_core.ProcessRow` rather than reused, the way `/graph`'s models are:\nthe wire format is `wiener-api`'s to keep stable, and the pure package's types answer to\nthe fold. Declared field by field rather than as a `dict`, because the generated client is\nwhat stops the two halves drifting and a `dict` reaches TypeScript as nothing at all."}, "RunAccepted": {"properties": {"run_id": {"type": "string", "title": "Run Id"}}, "type": "object", "required": ["run_id"], "title": "RunAccepted"}, "RunGraphOut": {"properties": {"nodes": {"items": {"$ref": "#/components/schemas/PlacedNode"}, "type": "array", "title": "Nodes", "default": []}, "wires": {"items": {"$ref": "#/components/schemas/DrawnWire"}, "type": "array", "title": "Wires", "default": []}, "width": {"type": "integer", "title": "Width", "default": 0}, "height": {"type": "integer", "title": "Height", "default": 0}}, "type": "object", "title": "RunGraphOut"}, "RunRow": {"properties": {"id": {"type": "string", "title": "Id"}, "phase": {"type": "string", "title": "Phase"}, "executor": {"type": "string", "title": "Executor"}, "submitted_by": {"type": "string", "title": "Submitted By"}, "submitted_at": {"type": "string", "format": "date-time", "title": "Submitted At"}}, "type": "object", "required": ["id", "phase", "executor", "submitted_by", "submitted_at"], "title": "RunRow"}, "SubmitRequest": {"properties": {"artifact_id": {"type": "string", "title": "Artifact Id"}, "params": {"additionalProperties": {"anyOf": [{"type": "string"}, {"items": {"type": "string"}, "type": "array"}]}, "type": "object", "title": "Params", "default": {}}, "executor": {"type": "string", "const": "local", "title": "Executor", "default": "local"}}, "additionalProperties": false, "type": "object", "required": ["artifact_id"], "title": "SubmitRequest"}, "TaskOut": {"properties": {"task_id": {"type": "integer", "title": "Task Id"}, "process": {"type": "string", "title": "Process"}, "status": {"type": "string", "title": "Status"}, "attempts": {"type": "integer", "title": "Attempts", "default": 1}, "latest_exit": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Latest Exit"}, "last_change_ms": {"type": "integer", "title": "Last Change Ms", "default": 0}, "peak_rss_bytes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Peak Rss Bytes"}, "realtime_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Realtime Ms"}, "pct_cpu": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Pct Cpu"}, "tag": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Tag"}}, "type": "object", "required": ["task_id", "process", "status"], "title": "TaskOut", "description": "One task row. `tag` is the laboratory's own word for it \u2014 A200 \u2014 and it is the only\nfield here that a laboratory wrote."}, "TasksOut": {"properties": {"tasks": {"items": {"$ref": "#/components/schemas/TaskOut"}, "type": "array", "title": "Tasks", "default": []}, "total": {"type": "integer", "title": "Total", "default": 0}}, "type": "object", "title": "TasksOut"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
