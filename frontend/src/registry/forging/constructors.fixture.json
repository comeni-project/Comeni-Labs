              }
            ],
            "default": null
          },
          "default": {
            "default": null,
            "title": "Default"
          },
          "because": {
            "default": "",
            "title": "Because",
            "type": "string"
          },
          "via": {
            "$ref": "#/$defs/Via"
          },
          "key": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExtKey"
              },
              {
